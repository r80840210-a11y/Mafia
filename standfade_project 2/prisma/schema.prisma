generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  telegramId BigInt  @unique
  username  String?
  coins     Int      @default(0)
  createdAt DateTime @default(now())
}
